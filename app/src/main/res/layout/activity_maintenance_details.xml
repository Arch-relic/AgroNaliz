<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textMaintenanceVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="32dp" />

        <TextView
            android:id="@+id/textMaintenanceDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textMaintenanceMeter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выполненные работы"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textMaintenanceWork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Примечание"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textMaintenanceNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="8dp" />
			
			<Button
    android:id="@+id/buttonDeleteMaintenance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Удалить запись"
    android:layout_marginTop="12dp" />
	
	<Button
    android:id="@+id/buttonEditMaintenance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Редактировать запись"
    android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>