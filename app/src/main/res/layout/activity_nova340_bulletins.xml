            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.32 — Мост управляемых колес ведущий"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin33"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.33 — Идентификационный номер комбайна на паспортной табличке"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin34"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.34 — Система дистанционного мониторинга"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin35"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.35 — ТО датчика системы оценки возврата на домолот"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin36"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.36 — Заглушки. Гидрооборудование наклонной камеры"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin37"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.37 — Крепление первичных средств пожаротушения"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin38"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.38 — Очистка датчика сигнализатора засоренности"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>