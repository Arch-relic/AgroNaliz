            android:layout_height="wrap_content"
            android:text="NOVA 340 —\nЭксплуатационные бюллетени"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/buttonBulletin19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.19 — Замена колес"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.20 — Смазка кардана выгрузного шнека. Антифриз"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.21 — Аппликация РСМ-10Б.22.01.009"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.24 — Тормозная система с МВК Lovol"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.26 — Смазка обоймы наклонной камеры"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin27"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.27 — Сертификация"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin29"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="S300.29 — Зарядка и обслуживание АКБ"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonBulletin31"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
