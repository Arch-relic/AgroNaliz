<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textFieldName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Поле"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textFieldArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Площадь:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textFieldLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Местоположение:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textFieldNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Примечание:"
        android:textSize="18sp" />

    <Button
        android:id="@+id/buttonEditField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Редактировать поле" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="История по годам"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textFieldHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Пока нет сезонных работ по этому полю"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/yearsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/yearsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/buttonAllHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Все года" />

</LinearLayout>
