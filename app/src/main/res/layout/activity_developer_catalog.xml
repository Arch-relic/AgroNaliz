<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Справочник разработчика"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Контроль наполнения каталога техники"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="24dp" />
			
			<TextView
    android:id="@+id/textCatalogStats"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Подсчёт каталога..."
    android:textSize="15sp"
    android:padding="12dp"
    android:layout_marginBottom="12dp" />
	
	<EditText
    android:id="@+id/editCatalogSearch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Поиск: марка, модель или двигатель"
    android:singleLine="true"
    android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/catalogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>