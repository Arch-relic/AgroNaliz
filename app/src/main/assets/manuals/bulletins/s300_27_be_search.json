тификаци- онном номере комбайна. Данной деклараци- ей ООО «Комбайновый завод «Ростсельмаш» объявляет под свою ответственность, что комбайн соответствует основным требованиям безопасности и безвредности, изложенным в Директиве 2006/42/ЕС. 1 Введение 1-7","words":[{"start":0,"end":11,"x0":0.0573863,"y0":0.0142605,"x1":0.2773386,"y1":0.0243008},{"start":12,"end":23,"x0":0.0573863,"y0":0.0258994,"x1":0.1464963,"y1":0.0354006},{"start":24,"end":38,"x0":0.1496279,"y0":0.0258994,"x1":0.2630381,"y1":0.0354006},{"start":39,"end":43,"x0":0.0952453,"y0":0.9581342,"x1":0.1358101,"y1":0.9738896},{"start":44,"end":46,"x0":0.1415816,"y0":0.9581342,"x1":0.1628527,"y1":0.9738896},{"start":47,"end":54,"x0":0.1686353,"y0":0.9581342,"x1":0.2362372,"y1":0.9738896},{"start":55,"end":58,"x0":0.5476698,"y0":0.0474244,"x1":0.5769984,"y1":0.0631797},{"start":59,"end":67,"x0":0.5858599,"y0":0.0474244,"x1":0.6894435,"y1":0.0631797},{"start":68,"end":70,"x0":0.6983603,"y0":0.0474244,"x1":0.725268,"y1":0.0631797},{"start":71,"end":83,"x0":0.7341497,"y0":0.0474244,"x1":0.8930825,"y1":0.0631797},{"start":84,"end":88,"x0":0.9019737,"y0":0.0474244,"x1":0.9524681,"y1":0.0631797},{"start":89,"end":99,"x0":0.5476717,"y0":0.0631014,"x1":0.6827646,"y1":0.0788567},{"start":100,"end":112,"x0":0.6882163,"y0":0.0631014,"x1":0.8395352,"y1":0.0788567},{"start":113,"end":120,"x0":0.5476717,"y0":0.0944553,"x1":0.6213351,"y1":0.1102107},{"start":121,"end":122,"x0":0.6338613,"y0":0.0944553,"x1":0.6435452,"y1":0.1102107},{"start":123,"end":128,"x0":0.6560898,"y0":0.0944553,"x1":0.7033815,"y1":0.1102107},{"start":129,"end":135,"x0":0.7159298,"y0":0.0944553,"x1":0.7787268,"y1":0.1102107},{"start":136,"end":148,"x0":0.7912807,"y0":0.0944553,"x1":0.9096116,"y1":0.1102107},{"start":149,"end":152,"x0":0.9221453,"y0":0.0944553,"x1":0.9524718,"y1":0.1102107},{"start":153,"end":163,"x0":0.5476737,"y0":0.1101323,"x1":0.6509246,"y1":0.1258876},{"start":164,"end":165,"x0":0.6660343,"y0":0.1101323,"x1":0.6764388,"y1":0.1258876}